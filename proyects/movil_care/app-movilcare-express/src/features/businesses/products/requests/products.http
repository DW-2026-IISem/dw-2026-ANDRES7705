@accessToken = "eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.eyJzdWIiOiIxIiwidXNlcm5hbWUiOiJhbmRyZXMubW9zY290ZSIsImlhdCI6MTc5MjAxMjY2OCwiZXhwIjoxNzkyMDEzNTY4LCJhdWQiOiJtb3ZpbGNhcmUtYXBpIiwiaXNzIjoibW92aWxjYXJlLWV4cHJlc3MifQ.TmdYxCqkmvP4YoPTMnVM6RzzryRrPNuqysvbcGfoiMo"
@id = 1

### List products
GET {{baseUrl}}/products
Authorization: Bearer {{accessToken}}
Content-Type: application/json

### Read one product
GET {{baseUrl}}/products/{{id}}
Authorization: Bearer {{accessToken}}
Content-Type: application/json


{
  "sku": "DEMO-PRODUCT-001",
  "name": "Demo equipment",
  "type": "EQUIPMENT",
  "productTypeId": 1,
  "price": "125000.00",
  "requiresSerial": true
}

### Replace product
PUT {{baseUrl}}/products/{{id}}
Content-Type: application/json

{
  "sku": "DEMO-PRODUCT-001",
  "name": "Demo equipment",
  "type": "EQUIPMENT",
  "productTypeId": 1,
  "price": "125000.00"
}

### Partially update product
PATCH {{baseUrl}}/products/{{id}}
Content-Type: application/json

{
  "isActive": false
}

### Soft-delete product
DELETE {{baseUrl}}/products/{{id}}

###

### Explicitly deactivate product
PATCH {{baseUrl}}/products/{{id}}/deactivate

###

### Permanently delete product
DELETE {{baseUrl}}/products/{{id}}/permanent
